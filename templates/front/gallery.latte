{layout 'layout.latte'}

{block content}
	<h1>{$t['galleryTitle']}</h1>
	<p>
		{if $allActive}<strong>{$t['allCategories']}</strong>{else}<a href="{$allUrl}">{$t['allCategories']}</a>{/if}
		{foreach $categories as $category}
			| {if $category['active']}<strong>{$category['name']}</strong>{else}<a href="{$category['url']}">{$category['name']}</a>{/if}
		{/foreach}
	</p>
	{foreach $groups as $group}
		<h2>{$group['title']}</h2>
		<plant-gallery>
			{foreach $group['photos'] as $photo}
				<a href="{$uploadsUrl}/medium/{$photo['filename']}" title="{$photo['name']}"><img src="{$uploadsUrl}/thumb/{$photo['filename']}" alt="{$photo['name']}" loading="lazy"></a>
			{/foreach}
		</plant-gallery>
	{else}
		<p>{$t['noItems']}</p>
	{/foreach}
{/block}
