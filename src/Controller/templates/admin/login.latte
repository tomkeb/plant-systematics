{layout '../base.latte'}
{var $htmlLang = 'en'}

{block title}Login – Admin: {$t['siteName']}{/block}

{block layoutHead}
	<meta name="robots" content="noindex">
{/block}

{block body}
<div class="container">
	<main>
		<h1>Admin login</h1>
		{foreach $flash as $message}<p><strong>{$message}</strong></p>{/foreach}
		{foreach $errors as $error}<p><strong>{$error}</strong></p>{/foreach}
		<form method="post" action="/admin/login">
			<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
			<p><label>Email<br><input type="email" name="email" required autofocus></label></p>
			<p><label>Password<br><input type="password" name="password" required></label></p>
			<p><button type="submit">Log in</button></p>
		</form>
		<p><a href="{$homeUrl}">← Back to site</a></p>
	</main>
</div>
{/block}
