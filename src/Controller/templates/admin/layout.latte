<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex">
	<title>{block title}Admin{/block}</title>
	<link rel="stylesheet" href="/assets/base.css">
	<link rel="stylesheet" href="/assets/contextual.css">
	{block head}{/block}
</head>
<body>
	<header>
		<p><a href="/admin"><strong>Admin</strong></a></p>
		<nav>
			<ul>
				{foreach $titles as $key => $label}
					<li><a href="/admin/{$key}">{$label}</a></li>
				{/foreach}
				<li><a href="/{$lang}/" target="_blank">View site</a></li>
				{if $currentUser}
					<li>
						<form method="post" action="/admin/logout">
							<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
							<button type="submit">Log out ({$currentUser['email']})</button>
						</form>
					</li>
				{/if}
			</ul>
		</nav>
	</header>
	<hr>
	<main>
		{foreach $flash as $message}
			<p><strong>{$message}</strong></p>
		{/foreach}
		{block content}{/block}
	</main>
	{block scripts}{/block}
</body>
</html>
