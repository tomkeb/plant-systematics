{layout '../base.latte'}
{var $htmlLang = 'en'}

{block title}Admin: {$t['siteName']}{/block}

{block layoutHead}
	<meta name="robots" content="noindex">
{/block}

{block body}
<div class="container">
	<header class="flex-horizontal jc-between ai-center gap-2 py-2">
		<div class="sitename"><a href="/admin">Admin: {$t['siteName']}</a></div>
		<div class="site-header-right text-right gap-05 flex-vertical ai-end">
			<div n:if="$currentUser">
				<form method="post" action="/admin/logout">
					<small>{$currentUser['email']}</small>
					<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
					<button type="submit">Log out</button>
				</form>
			</div>
			<nav>
				<ul>
					{foreach $titles as $key => $label}
						<li><a href="/admin/{$key}">{$label}</a></li>
					{/foreach}
					<li><a href="/{$lang}/" target="_blank">View site</a></li>
				</ul>
			</nav>
		</div>
	</header>
	<main>
		{foreach $flash as $message}
			<p><strong>{$message}</strong></p>
		{/foreach}
		{block content}{/block}
	</main>
	{block scripts}{/block}
</div>
{/block}
