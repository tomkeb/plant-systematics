{layout '../base.latte'}

{block layoutHead}
	<link rel="stylesheet" href="/assets/plant-gallery.bundle.css">
	<script src="/assets/plant-gallery.bundle.js" defer></script>
	<link rel="alternate" hreflang="{$otherLang}" href="{$otherLangUrl}">
{/block}

{block body}
<div class="container">
	<aside n:if="$isAdmin">
		<small>Logged in as {$currentUser['email']}
		| <a href="/admin">Admin</a>
		{if $editUrl}| <a href="{$editUrl}">{$editLabel}</a>{/if}
		</small>
		<form method="post" action="/admin/logout">
			<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
			<input type="hidden" name="redirect" value="{$currentUrl}">
			<button type="submit">Log out</button>
		</form>
	</aside>
	<header class="site-header flex-horizontal jc-between ai-center gap-2">
		<div class="sitename"><a href="{$homeUrl}">{$t['siteName']}</a></div>
		<button type="button" class="menu-toggle" aria-controls="site-menu" aria-expanded="false" aria-label="Menu">
			<svg class="icon-open" width="26" height="26" aria-hidden="true"><use href="/assets/menu.svg#menu"></use></svg>
			<svg class="icon-close" width="26" height="26" aria-hidden="true"><use href="/assets/menu.svg#close"></use></svg>
		</button>
		<div class="site-header-right" id="site-menu">
			<div class="lang-switch"><a href="{$otherLangUrl}" hreflang="{$otherLang}">{$t['otherLanguage']}</a></div>
			<nav>
				<ul>
					{foreach $menu as $menuItem}
						<li><a href="{$menuItem['url']}" n:class="$menuItem['active'] ? active">{$menuItem['label']}</a></li>
					{/foreach}
				</ul>
			</nav>
		</div>
	</header>
	<script>
		(function () {
			var header = document.currentScript.previousElementSibling;
			var toggle = header.querySelector('.menu-toggle');
			toggle.addEventListener('click', function () {
				var open = header.classList.toggle('menu-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		})();
	</script>
	<main>
		{block content}{/block}
	</main>
</div>
{/block}
