<!doctype html>
<html lang="{$lang}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{block title}{$t['siteName']}{/block}</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap">
	<link rel="stylesheet" href="/assets/base.css">
	<link rel="stylesheet" href="/assets/contextual.css">
	<link rel="stylesheet" href="/assets/plant-gallery.bundle.css">
	<script src="/assets/plant-gallery.bundle.js" defer></script>
	<link rel="alternate" hreflang="{$otherLang}" href="{$otherLangUrl}">
</head>
<body>
	<aside n:if="$isAdmin">
		<small>Logged in as {$currentUser['email']}
		| <a href="/admin">Admin</a>
		{if $editUrl}| <a href="{$editUrl}">{$editLabel}</a>{/if}
		</small>
		<form method="post" action="/admin/logout">
			<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
			<input type="hidden" name="redirect" value="{$currentUrl}">
			<button type="submit">Log out</button>
		</form>
	</aside>
	<header>
		<p><a href="{$homeUrl}"><strong>{$t['siteName']}</strong></a></p>
		<nav>
			<ul>
				{foreach $menu as $menuItem}
					<li>
						{if $menuItem['active']}
							<strong><a href="{$menuItem['url']}">{$menuItem['label']}</a></strong>
						{else}
							<a href="{$menuItem['url']}">{$menuItem['label']}</a>
						{/if}
					</li>
				{/foreach}
				<li><a href="{$otherLangUrl}" hreflang="{$otherLang}">{$t['otherLanguage']}</a></li>
			</ul>
		</nav>
	</header>
	<hr>
	<main>
		{block content}{/block}
	</main>
</body>
</html>
