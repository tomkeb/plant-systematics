{layout '../base.latte'}

{block layoutHead}
	<link rel="stylesheet" href="/assets/plant-gallery.bundle.css">
	<script src="/assets/plant-gallery.bundle.js" defer></script>
	<link rel="alternate" hreflang="{$otherLang}" href="{$otherLangUrl}">
{/block}

{block body}
<div class="container">
	<aside n:if="$isAdmin">
		<small>Logged in as {$currentUser['email']}
		| <a href="/admin">Admin</a>
		{if $editUrl}| <a href="{$editUrl}">{$editLabel}</a>{/if}
		</small>
		<form method="post" action="/admin/logout">
			<input type="hidden" name="{$csrfField}" value="{$csrfToken}">
			<input type="hidden" name="redirect" value="{$currentUrl}">
			<button type="submit">Log out</button>
		</form>
	</aside>
	<header class="flex-horizontal jc-between ai-center gap-2 py-2">
		<div class="sitename"><a href="{$homeUrl}">{$t['siteName']}</a></div>
		<div class="site-header-right text-right gap-05 flex-vertical ai-end">
			<div class="lang-switch"><a href="{$otherLangUrl}" hreflang="{$otherLang}">{$t['otherLanguage']}</a></div>
			<nav>
				<ul>
					{foreach $menu as $menuItem}
						<li><a href="{$menuItem['url']}" n:class="$menuItem['active'] ? active">{$menuItem['label']}</a></li>
					{/foreach}
				</ul>
			</nav>
		</div>
	</header>
	<main>
		{block content}{/block}
	</main>
</div>
{/block}
