{layout 'layout.latte'}

{block content}
	<h1>{$t['thesesTitle']}</h1>
	{foreach $groups as $group}
		<h2>{$group['title']}</h2>
		{foreach $group['items'] as $item}
			<h3>{$item['name']}</h3>
			<p><small>{$item['categoryName']}</small></p>
			<p n:if="$isAdmin"><small><a href="{adminEditUrl('theses', $item['_id'])}">Edit</a></small></p>
			{$item['desc']|markdown}
		{/foreach}
	{else}
		<p>{$t['noItems']}</p>
	{/foreach}
{/block}
