{
  "name": "tomkeb/plant-systematics",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "rakibtg/sleekdb": "^2.15",
    "latte/latte": "^3.0",
    "intervention/image": "^3.0",
    "ezyang/htmlpurifier": "^4.17",
    "npm-asset/quill": "^2.0",
    "oomphinc/composer-installers-extender": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "extra": {
    "installer-types": [
      "npm-asset"
    ],
    "installer-paths": {
      "public/assets/vendor/{$name}/": [
        "type:npm-asset"
      ]
    }
  }
}